---
interface Props {
  title?: string;
  description?: string;
}
const { title = "Il Sotterraneo Osteria Urbana — Velletri", description = "Osteria urbana a Velletri: locale intimo e curato, cucina casareccia con twist creativo. 4.6 su Google con 175 recensioni. Corso della Repubblica 372." } = Astro.props;
import { AstroFont } from 'astro-font';
---

<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#2F3E2B" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="restaurant" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/images/hero.jpg" />
  <meta property="og:locale" content="it_IT" />

  <!-- JSON-LD LocalBusiness -->
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": "Il Sotterraneo Osteria Urbana",
    "servesCuisine": "Cucina italiana, osteria",
    "priceRange": "€€",
    "telephone": "+390685350920",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Corso della Repubblica, 372",
      "addressLocality": "Velletri",
      "postalCode": "00049",
      "addressRegion": "RM",
      "addressCountry": "IT"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": 41.6840989, "longitude": 12.7761052 },
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.6", "reviewCount": "175" },
    "url": "https://dawiddroz.github.io/il-sotterraneo-osteria-urbana/"
  }
  </script>

  <!-- Fonts self-hosted -->
  <AstroFont
    config={[
      {
        name: "Cormorant Garamond",
        src: [],
        googleFontsURL: "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&display=swap",
        preload: true,
        display: "swap",
        selector: ":root",
        fallback: "serif",
        fetch: true,
      },
      {
        name: "Inter",
        src: [],
        googleFontsURL: "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap",
        preload: true,
        display: "swap",
        selector: ":root",
        fallback: "sans-serif",
        fetch: true,
      },
    ]}
  />

  <!-- CDN: GSAP + ScrollTrigger + Lenis -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/lenis@1.3.13/dist/lenis.min.js" defer></script>

  <!-- Leaflet -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>

  <!-- Anti-flash: CSS nasconde gli elementi che GSAP rivelerà -->
  <style is:global>
    /* ============ DESIGN SYSTEM ============ */
    :root {
      --bg: #FFFAF5;
      --bg-deep: #2F3E2B;
      --bg-deep-2: #25322a;
      --surface: #FFF4E8;
      --text: #2C2416;
      --text-soft: #6b5d4c;
      --primary: #C67B4B;
      --primary-dark: #A85E32;
      --accent: #C9A96E;
      --line: rgba(198, 123, 75, 0.18);
      --line-strong: rgba(198, 123, 75, 0.35);
      --font-display: 'Cormorant Garamond', Georgia, serif;
      --font-body: 'Inter', system-ui, sans-serif;
      --radius-sm: 4px;
      --radius-md: 10px;
      --radius-lg: 18px;
      --shadow: 0 8px 32px rgba(44, 36, 22, 0.10);
      --shadow-lg: 0 20px 60px rgba(44, 36, 22, 0.18);
      --container: 1200px;
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: auto; }

    body {
      font-family: var(--font-body);
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    ul { list-style: none; }

    .container { max-width: var(--container); margin: 0 auto; padding: 0 24px; }

    /* ============ TIPOGRAFIA ============ */
    h1, h2, h3, .display {
      font-family: var(--font-display);
      font-weight: 600;
      line-height: 1.12;
      letter-spacing: -0.01em;
    }

    .section { padding: 96px 0; }
    .section--dark { background: var(--bg-deep); color: #F3ECDD; }
    .section--dark .section__label { color: var(--accent); }
    .section--dark .section__title { color: #FAF5E9; }
    .section--dark .section__text { color: rgba(243, 236, 221, 0.82); }

    .section__label {
      display: inline-flex; align-items: center; gap: 10px;
      font-size: 12px; font-weight: 600;
      text-transform: uppercase; letter-spacing: 3px;
      color: var(--primary); margin-bottom: 18px;
    }
    .section__label::before {
      content: ""; width: 34px; height: 1px; background: var(--accent);
    }
    .section__title {
      font-size: clamp(2.2rem, 4.6vw, 3.6rem);
      margin-bottom: 20px;
    }
    .section__title em { font-style: italic; color: var(--primary); }
    .section__text { font-size: 1.05rem; color: var(--text-soft); max-width: 640px; }

    /* ============ BOTTONI ============ */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      padding: 15px 30px; border-radius: 999px;
      font-weight: 600; font-size: 0.95rem; letter-spacing: 0.02em;
      transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
      cursor: pointer; border: 1px solid transparent;
      min-height: 48px;
    }
    .btn svg { flex-shrink: 0; }
    .btn--primary { background: var(--primary); color: #fff; box-shadow: 0 10px 30px rgba(198, 123, 75, 0.35); }
    .btn--primary:hover { background: var(--primary-dark); transform: translateY(-2px); box-shadow: 0 14px 38px rgba(198, 123, 75, 0.45); }
    .btn:active { transform: scale(0.96); }
    .btn--outline { border-color: var(--accent); color: var(--accent); }
    .btn--outline:hover { background: rgba(201, 169, 110, 0.12); transform: translateY(-2px); }
    .btn--light { background: #FAF5E9; color: var(--bg-deep); }
    .btn--light:hover { transform: translateY(-2px); box-shadow: 0 14px 40px rgba(0,0,0,0.25); }

    /* ============ NAVBAR ============ */
    .navbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      padding: 20px 0;
      transition: background 0.4s ease, padding 0.4s ease, box-shadow 0.4s ease;
    }
    .navbar--scrolled {
      background: rgba(255, 250, 245, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      padding: 12px 0;
      box-shadow: 0 2px 24px rgba(44, 36, 22, 0.08);
    }
    .navbar__inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .navbar__logo { display: flex; align-items: baseline; gap: 8px; font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: #FAF5E9; }
    .navbar--scrolled .navbar__logo { color: var(--text); }
    .navbar__logo span { font-family: var(--font-body); font-size: 0.62rem; font-weight: 600; text-transform: uppercase; letter-spacing: 2.5px; color: var(--accent); }
    .navbar__links { display: flex; align-items: center; gap: 30px; }
    .navbar__links a:not(.btn) {
      font-size: 0.9rem; font-weight: 500; color: rgba(250, 245, 233, 0.85);
      transition: color 0.25s ease; position: relative;
    }
    .navbar--scrolled .navbar__links a:not(.btn) { color: var(--text-soft); }
    .navbar__links a:not(.btn)::after {
      content: ""; position: absolute; left: 0; bottom: -5px;
      width: 0; height: 2px; background: var(--accent);
      transition: width 0.3s ease;
    }
    .navbar__links a:not(.btn):hover::after { width: 100%; }
    .navbar__cta { padding: 10px 22px; font-size: 0.85rem; min-height: 42px; }

    .navbar__burger { display: none; background: none; border: 0; cursor: pointer; padding: 8px; }
    .navbar__burger span {
      display: block; width: 26px; height: 2px; background: #FAF5E9;
      margin: 6px 0; transition: transform 0.3s ease, opacity 0.2s ease;
      transform-origin: center;
    }
    .navbar--scrolled .navbar__burger span { background: var(--text); }
    .navbar__burger.open span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    .navbar__burger.open span:nth-child(2) { opacity: 0; }
    .navbar__burger.open span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

    @media (max-width: 900px) {
      .navbar__links {
        position: fixed; top: 0; right: 0; bottom: 0;
        width: min(320px, 82vw);
        background: var(--bg-deep);
        flex-direction: column; align-items: flex-start; justify-content: flex-start;
        padding: 110px 36px 40px; gap: 26px;
        transform: translateX(100%);
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
        box-shadow: -20px 0 60px rgba(0,0,0,0.3);
      }
      .navbar__links.open { transform: translateX(0); }
      .navbar__links a:not(.btn) { color: rgba(250, 245, 233, 0.9) !important; font-size: 1.15rem; }
      .navbar__burger { display: block; z-index: 110; }
      .navbar__cta { display: none; }
      .navbar__links .btn--mobile-visible { display: inline-flex; }
    }
    @media (min-width: 901px) { .btn--mobile-visible { display: none; } }

    /* ============ HERO ============ */
    .hero {
      position: relative;
      min-height: 100svh;
      display: flex; align-items: flex-end;
      background: #1E2820;
      overflow: hidden;
    }
    .hero__bg {
      position: absolute; inset: 0;
      background: url('/images/hero.jpg') center 30% / cover no-repeat;
      opacity: 0.5;
      transform: scale(1.08);
      animation: heroBgIn 2.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes heroBgIn {
      from { transform: scale(1.18); opacity: 0; }
      to { transform: scale(1.08); opacity: 0.5; }
    }
    .hero__veil {
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(23, 31, 26, 0.82) 0%, rgba(30, 40, 32, 0.35) 45%, rgba(18, 25, 20, 0.92) 100%);
    }
    /* La luce che sale */
    .hero__light {
      position: absolute; left: -20%; right: -20%; bottom: -45%;
      height: 95%;
      background: radial-gradient(ellipse 60% 55% at 50% 78%, rgba(230, 178, 110, 0.42), transparent 65%);
      transform: translateY(70%);
      animation: lightRise 2.2s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
      pointer-events: none;
    }
    @keyframes lightRise {
      from { transform: translateY(70%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .hero__content {
      position: relative; z-index: 5;
      width: 100%;
      padding: 140px 0 90px;
      color: #FAF5E9;
    }
    .hero__badge {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 9px 20px; border-radius: 999px;
      border: 1px solid rgba(201, 169, 110, 0.4);
      background: rgba(47, 62, 43, 0.5);
      font-size: 0.8rem; font-weight: 500; letter-spacing: 1.6px; text-transform: uppercase;
      color: #E8D5AC; margin-bottom: 26px;
      opacity: 0; transform: translateY(22px);
      animation: riseIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.5s forwards;
    }
    .hero__title {
      font-size: clamp(3.1rem, 8.4vw, 6.4rem);
      font-weight: 600; color: #FDF8EC; margin-bottom: 10px;
      text-shadow: 0 4px 40px rgba(0, 0, 0, 0.45);
    }
    .hero__title .line { display: block; overflow: hidden; }
    .hero__title .line span {
      display: inline-block;
      opacity: 0; transform: translateY(60px);
    }
    .hero__title .line:nth-child(1) span { animation: riseIn 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.75s forwards; }
    .hero__title .line:nth-child(2) span {
      font-style: italic; color: #E4C98F;
      animation: riseIn 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.95s forwards;
    }
    @keyframes riseIn {
      from { opacity: 0; transform: translateY(56px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Titolo hero: glow dorato che respira dopo l'entrata */
    .hero__title {
      animation: titleGlow 5.5s ease-in-out 2.2s infinite;
    }
    @keyframes titleGlow {
      0%, 100% { text-shadow: 0 4px 40px rgba(0, 0, 0, 0.45); }
      50% { text-shadow: 0 4px 46px rgba(228, 201, 143, 0.35), 0 4px 40px rgba(0, 0, 0, 0.45); }
    }

    /* Badge hero: riflesso che passa ogni 4s */
    .hero__badge { position: relative; overflow: hidden; }
    .hero__badge::after {
      content: ""; position: absolute; top: 0; bottom: 0; width: 35%; left: -50%;
      background: linear-gradient(105deg, transparent, rgba(255,255,255,0.18), transparent);
      transform: skewX(-20deg);
      animation: badgeShine 4.2s ease-in-out 2.8s infinite;
      pointer-events: none;
    }
    @keyframes badgeShine {
      0% { left: -50%; }
      50% { left: 130%; }
      100% { left: 130%; }
    }

    /* Numeri stats: respiro sottile dopo il counter */
    .hero__stat .num { animation: numBreath 4.5s ease-in-out 3.2s infinite; }
    @keyframes numBreath {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.045); }
    }
    .hero__sub {
      max-width: 560px; margin: 20px 0 36px;
      font-size: 1.1rem; color: rgba(250, 245, 233, 0.88);
      opacity: 0; transform: translateY(24px);
      animation: riseIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) 1.2s forwards;
    }
    .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 52px;
      opacity: 0; transform: translateY(24px);
      animation: riseIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) 1.4s forwards; }
    .hero__stats {
      display: flex; flex-wrap: wrap; gap: 40px; padding-top: 30px;
      border-top: 1px solid rgba(250, 245, 233, 0.16);
      opacity: 0; transform: translateY(24px);
      animation: riseIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) 1.6s forwards;
    }
    .hero__stat .num { font-family: var(--font-display); font-size: 2.3rem; font-weight: 700; color: #F3E7C8; line-height: 1; }
    .hero__stat .lbl { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1.8px; color: rgba(250, 245, 233, 0.6); margin-top: 6px; }
    .hero__scroll { position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%); z-index: 5; color: rgba(250,245,233,0.55); font-size: 0.7rem; letter-spacing: 2.5px; text-transform: uppercase; display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .hero__scroll::after { content: ""; width: 1px; height: 44px; background: linear-gradient(180deg, rgba(250,245,233,0.5), transparent); animation: scrollPulse 2s ease-in-out infinite; }
    @keyframes scrollPulse { 0%,100% { opacity: 1 } 50% { opacity: 0.3 } }

    /* Spotlight: glow caldi che seguono il mouse (desktop) */
    .hero__spot {
      position: absolute; border-radius: 50%;
      pointer-events: none; z-index: 3;
      mix-blend-mode: screen;
      transform: translate(-50%, -50%);
    }
    .hero__spot--warm {
      width: 420px; height: 420px;
      background: radial-gradient(circle, rgba(230, 178, 110, 0.20), transparent 65%);
    }
    .hero__spot--soft {
      width: 260px; height: 260px;
      background: radial-gradient(circle, rgba(255, 240, 210, 0.14), transparent 60%);
    }

    /* Particelle di luce (polvere dorata che sale nella luce) — CSS-only */
    .hero__ember {
      position: absolute; bottom: -12px; width: 4px; height: 4px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(228, 201, 143, 0.95), rgba(228, 201, 143, 0));
      opacity: 0; pointer-events: none;
      animation: emberRise 8s linear infinite;
    }
    .hero__ember:nth-child(1) { left: 8%;  animation-duration: 8.5s; animation-delay: 0s;    width: 5px; height: 5px; }
    .hero__ember:nth-child(2) { left: 18%; animation-duration: 7.2s; animation-delay: 1.4s;  width: 3px; height: 3px; }
    .hero__ember:nth-child(3) { left: 30%; animation-duration: 9.4s; animation-delay: 0.8s;  width: 4px; height: 4px; }
    .hero__ember:nth-child(4) { left: 42%; animation-duration: 6.8s; animation-delay: 2.2s;  width: 3px; height: 3px; }
    .hero__ember:nth-child(5) { left: 55%; animation-duration: 8.9s; animation-delay: 0.4s;  width: 5px; height: 5px; }
    .hero__ember:nth-child(6) { left: 66%; animation-duration: 7.6s; animation-delay: 3.0s;  width: 3px; height: 3px; }
    .hero__ember:nth-child(7) { left: 76%; animation-duration: 9.8s; animation-delay: 1.1s;  width: 4px; height: 4px; }
    .hero__ember:nth-child(8) { left: 86%; animation-duration: 8.1s; animation-delay: 2.6s;  width: 3px; height: 3px; }
    .hero__ember:nth-child(9) { left: 94%; animation-duration: 7.0s; animation-delay: 1.8s;  width: 4px; height: 4px; }
    .hero__ember:nth-child(10){ left: 49%; animation-duration: 9.2s; animation-delay: 3.4s;  width: 3px; height: 3px; }
    @keyframes emberRise {
      0%   { transform: translateY(0) translateX(0) scale(0.6); opacity: 0; }
      8%   { opacity: 0.85; }
      50%  { transform: translateY(-42vh) translateX(16px) scale(1); opacity: 0.55; }
      100% { transform: translateY(-88vh) translateX(-14px) scale(0.5); opacity: 0; }
    }

    /* Embers generici per qualsiasi sezione scura (posizionamento per sezione) */
    .embers { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
    .ember {
      position: absolute; bottom: -12px; width: 4px; height: 4px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(228, 201, 143, 0.9), rgba(228, 201, 143, 0));
      opacity: 0;
      animation: emberRise 8s linear infinite;
    }
    .embers .ember:nth-child(1)  { left: 6%;  animation-duration: 8.4s; animation-delay: 0s; }
    .embers .ember:nth-child(2)  { left: 14%; animation-duration: 7.1s; animation-delay: 1.6s; width: 3px; height: 3px; }
    .embers .ember:nth-child(3)  { left: 24%; animation-duration: 9.6s; animation-delay: 0.7s; }
    .embers .ember:nth-child(4)  { left: 35%; animation-duration: 6.9s; animation-delay: 2.4s; width: 3px; height: 3px; }
    .embers .ember:nth-child(5)  { left: 48%; animation-duration: 8.8s; animation-delay: 0.3s; }
    .embers .ember:nth-child(6)  { left: 60%; animation-duration: 7.5s; animation-delay: 3.1s; width: 3px; height: 3px; }
    .embers .ember:nth-child(7)  { left: 72%; animation-duration: 9.2s; animation-delay: 1.1s; }
    .embers .ember:nth-child(8)  { left: 83%; animation-duration: 7.9s; animation-delay: 2.7s; width: 3px; height: 3px; }
    .embers .ember:nth-child(9)  { left: 91%; animation-duration: 6.6s; animation-delay: 1.9s; }
    .embers .ember:nth-child(10) { left: 97%; animation-duration: 8.2s; animation-delay: 3.6s; width: 3px; height: 3px; }

    /* Sezioni scure: position relative per contenere gli embers */
    .section--dark, .cta { position: relative; }

    /* ============ PROGRESS BAR (scroll) ============ */
    .progress-bar {
      position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 200;
      background: linear-gradient(90deg, var(--primary), var(--accent));
      transform-origin: left center; transform: scaleX(0);
    }

    /* ============ MARQUEE ============ */
    .marquee {
      background: var(--bg-deep);
      border-top: 1px solid rgba(201, 169, 110, 0.25);
      border-bottom: 1px solid rgba(201, 169, 110, 0.25);
      overflow: hidden; padding: 18px 0;
    }
    .marquee__track {
      display: flex; width: max-content;
      animation: marqueeScroll 26s linear infinite;
    }
    .marquee:hover .marquee__track { animation-play-state: paused; }
    .marquee__group { display: flex; align-items: center; gap: 0; padding-right: 0; }
    .marquee__item {
      font-family: var(--font-display); font-size: 1.35rem; font-weight: 600;
      color: #E4C98F; white-space: nowrap; padding: 0 28px;
      letter-spacing: 0.04em;
    }
    .marquee__item--dim { color: rgba(243, 236, 221, 0.55); font-style: italic; font-size: 1.1rem; }
    .marquee__sep { color: var(--primary); font-size: 1.1rem; }
    @keyframes marqueeScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* Scintille decorative nelle sezioni chiare */
    .sparkles { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
    .sparkle {
      position: absolute;
      color: var(--accent);
      opacity: 0;
      animation: sparkleFloat 7s ease-in-out infinite;
    }
    .sparkles .sparkle:nth-child(1) { top: 12%; left: 4%;  font-size: 15px; animation-delay: 0s; }
    .sparkles .sparkle:nth-child(2) { top: 68%; left: 7%;  font-size: 11px; animation-delay: 1.8s; }
    .sparkles .sparkle:nth-child(3) { top: 22%; right: 5%; font-size: 13px; animation-delay: 3.2s; }
    .sparkles .sparkle:nth-child(4) { top: 78%; right: 8%; font-size: 10px; animation-delay: 0.9s; }
    .sparkles .sparkle:nth-child(5) { top: 45%; left: 12%; font-size: 9px; animation-delay: 4.4s; }
    @keyframes sparkleFloat {
      0%   { opacity: 0; transform: translateY(14px) rotate(0deg) scale(0.7); }
      25%  { opacity: 0.75; }
      50%  { opacity: 0.2; transform: translateY(-10px) rotate(90deg) scale(1); }
      75%  { opacity: 0.65; }
      100% { opacity: 0; transform: translateY(-28px) rotate(180deg) scale(0.7); }
    }
    .section { position: relative; }

    /* ============ SPLIT WORDS (titoli animati) ============ */
    .wrd { display: inline-block; opacity: 0; transform: translateY(0.4em); will-change: transform, opacity; }
    .split-words em { font-style: italic; }

    /* ============ STAGGER ITEMS (menu, gallery, element-in) ============ */
    .menu__item { opacity: 0; transform: translateY(18px); }
    .gallery__item { opacity: 0; transform: translateY(24px); }
    .el-in { opacity: 0; transform: translateY(20px); }

    /* ============ STELLE RECENSIONI ============ */
    .rev__stars svg { transform-origin: center; }

    /* ============ SHINE CTA ============ */
    .btn--primary { position: relative; overflow: hidden; }
    .btn--primary::after {
      content: ""; position: absolute; top: 0; bottom: 0; width: 40%;
      left: -60%;
      background: linear-gradient(105deg, transparent, rgba(255,255,255,0.35), transparent);
      transform: skewX(-20deg);
      animation: shineSweep 3.6s ease-in-out 1.8s infinite;
      pointer-events: none;
    }
    @keyframes shineSweep {
      0% { left: -60%; }
      55% { left: 130%; }
      100% { left: 130%; }
    }

    /* ============ STORIA ============ */
    .storia__grid {
      display: grid; grid-template-columns: 1fr; gap: 44px;
      align-items: center;
    }
    .storia__photo { position: relative; overflow: hidden; }
    .img-reveal {
      position: absolute; inset: 0; z-index: 3;
      background: linear-gradient(120deg, var(--bg) 0%, var(--surface) 100%);
      transform: scaleX(1); transform-origin: right center;
      pointer-events: none;
    }
    .storia__photo img {
      width: 100%; height: 520px; object-fit: cover;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.8s ease;
    }
    .storia__photo:hover img { transform: scale(1.035); box-shadow: 0 26px 70px rgba(44, 36, 22, 0.24); }
    .storia__photo--offset { margin-top: 44px; margin-left: auto; width: 88%; }
    .storia__photo--offset img { height: 420px; }
    .storia__photo::after {
      content: ""; position: absolute; inset: 0;
      border-radius: var(--radius-lg);
      border: 1px solid var(--line-strong);
      transform: translate(14px, 14px);
      pointer-events: none;
    }
    .storia__quote {
      font-family: var(--font-display); font-style: italic;
      font-size: clamp(1.4rem, 2.6vw, 1.9rem); line-height: 1.45;
      color: var(--primary-dark); margin: 26px 0 8px;
    }
    .storia__name { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 2px; color: var(--text-soft); margin-bottom: 30px; }
    .storia__items { display: grid; gap: 14px; margin-top: 30px; }
    .storia__item { display: flex; gap: 14px; align-items: flex-start; }
    .storia__item svg { flex-shrink: 0; margin-top: 4px; color: var(--primary); }
    .storia__item b { display: block; font-size: 0.98rem; }
    .storia__item p { font-size: 0.92rem; color: var(--text-soft); }

    /* ============ MENU ============ */
    .menu__intro { max-width: 640px; margin-bottom: 56px; }
    .menu__grid { display: grid; grid-template-columns: 1fr; gap: 40px; }
    .menu__col h3 {
      font-size: 1.5rem; color: #E4C98F; margin-bottom: 8px;
      display: flex; align-items: center; gap: 12px;
    }
    .menu__col h3::after { content: ""; flex: 1; height: 1px; background: rgba(201, 169, 110, 0.25); }
    .menu__cat-note { font-size: 0.82rem; color: rgba(243, 236, 221, 0.55); margin-bottom: 22px; }
    .menu__item { padding: 15px 0; border-bottom: 1px dotted rgba(201, 169, 110, 0.28); transition: border-color 0.35s ease, padding-left 0.35s ease; }
    .menu__item:hover { border-color: rgba(228, 201, 143, 0.65); padding-left: 8px; }
    .menu__item-name { transition: color 0.3s ease, transform 0.3s ease; display: inline-block; }
    .menu__item:hover .menu__item-name { color: #E4C98F; transform: translateX(4px); }
    .menu__price { transition: color 0.3s ease, transform 0.3s ease; display: inline-block; }
    .menu__item:hover .menu__price { color: #F3E7C8; transform: scale(1.12); }
    .menu__item-row { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
    .menu__item-name { font-family: var(--font-display); font-size: 1.22rem; font-weight: 600; color: #F6EFDD; }
    .menu__item-desc { font-size: 0.88rem; color: rgba(243, 236, 221, 0.6); margin-top: 4px; max-width: 460px; }
    .menu__price { font-family: var(--font-display); font-size: 1.15rem; color: var(--accent); white-space: nowrap; }
    .menu__foot {
      margin-top: 48px; padding: 22px 28px;
      border: 1px solid rgba(201, 169, 110, 0.3); border-radius: var(--radius-md);
      background: rgba(201, 169, 110, 0.08);
      display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between;
      font-size: 0.95rem; color: rgba(243, 236, 221, 0.85);
    }

    /* ============ GALLERIA ============ */
    .gallery__grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px;
    }
    .gallery__item { position: relative; overflow: hidden; border-radius: var(--radius-md); }
    .gallery__item img {
      width: 100%; height: 100%; min-height: 220px; object-fit: cover;
      transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .gallery__item:hover img { transform: scale(1.07); }
    /* Caption che sale all'hover */
    .gallery__cap {
      position: absolute; inset: auto 0 0 0;
      padding: 34px 16px 14px;
      background: linear-gradient(180deg, transparent, rgba(23, 31, 26, 0.78));
      color: #F6EFDD; font-size: 0.88rem; font-weight: 500;
      transform: translateY(100%);
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      pointer-events: none;
    }
    .gallery__item:hover .gallery__cap { transform: translateY(0); }
    .gallery__item--tall { grid-row: span 2; }
    .gallery__item--tall img { min-height: 460px; }
    .gallery__item--wide { grid-column: span 2; }
    .gallery__item--wide img { min-height: 260px; }

    /* ============ RECENSIONI ============ */
    .rev__wrap { display: grid; grid-template-columns: 1fr; gap: 44px; align-items: center; }
    .rev__score { text-align: left; }
    .rev__big { font-family: var(--font-display); font-size: clamp(5rem, 12vw, 8rem); font-weight: 700; line-height: 0.9; color: var(--text); }
    .rev__big sup { font-size: 0.35em; color: var(--primary); font-weight: 600; }
    .rev__stars { display: flex; gap: 5px; margin: 18px 0 10px; }
    .rev__stars svg { color: var(--accent); }
    .rev__count { font-size: 1rem; color: var(--text-soft); }
    .rev__count b { color: var(--text); }
    .rev__text { font-family: var(--font-display); font-style: italic; font-size: clamp(1.3rem, 2.4vw, 1.7rem); line-height: 1.5; color: var(--primary-dark); margin-bottom: 24px; }
    .rev__platform { display: inline-flex; align-items: center; gap: 10px; font-size: 0.9rem; color: var(--text-soft); }
    .rev__platform svg { color: var(--primary); }
    .rev__note { font-size: 0.85rem; color: var(--text-soft); margin-top: 18px; max-width: 420px; }

    /* ============ CTA INVITO ============ */
    .cta {
      position: relative; overflow: hidden;
      background: var(--bg-deep);
      padding: 120px 0; text-align: center; color: #FAF5E9;
    }
    .cta__glow {
      position: absolute; left: 50%; top: -60%; transform: translateX(-50%);
      width: 900px; height: 900px;
      background: radial-gradient(circle, rgba(201, 169, 110, 0.22), transparent 62%);
      pointer-events: none;
      animation: glowBreath 7s ease-in-out infinite;
    }
    @keyframes glowBreath {
      0%, 100% { opacity: 0.75; transform: translateX(-50%) scale(1); }
      50% { opacity: 1; transform: translateX(-50%) scale(1.12); }
    }
    .cta__title { font-size: clamp(2.6rem, 6vw, 4.6rem); color: #FDF8EC; margin-bottom: 18px; }
    .cta__title em { font-style: italic; color: #E4C98F; }
    .cta__text { max-width: 520px; margin: 0 auto 38px; color: rgba(250, 245, 233, 0.8); font-size: 1.05rem; }
    .cta__btns { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }

    /* ============ MAPPA ============ */
    .map__wrap { display: grid; grid-template-columns: 1fr; gap: 0; overflow: hidden; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
    .map__frame { min-height: 380px; background: #E9E2D4; }

    /* Marker mappa: dot + anello pulsante */
    .map-pin-wrap { background: transparent; border: none; }
    .map-pin { position: relative; width: 34px; height: 34px; }
    .map-pin__dot {
      position: absolute; left: 50%; top: 50%;
      width: 16px; height: 16px; transform: translate(-50%, -50%);
      background: var(--primary); border: 3px solid #fff; border-radius: 50%;
      box-shadow: 0 3px 10px rgba(44, 36, 22, 0.35);
      z-index: 2;
    }
    .map-pin__ring {
      position: absolute; left: 50%; top: 50%;
      width: 16px; height: 16px; transform: translate(-50%, -50%);
      border: 2px solid var(--primary); border-radius: 50%;
      animation: pinPulse 2.2s ease-out infinite;
    }
    @keyframes pinPulse {
      0% { width: 16px; height: 16px; opacity: 0.9; }
      100% { width: 62px; height: 62px; opacity: 0; }
    }
    .map__frame .leaflet-container { font-family: var(--font-body); }
    .map__info { background: var(--surface); padding: 40px 34px; display: flex; flex-direction: column; gap: 20px; justify-content: center; }
    .map__info h3 { font-size: 1.6rem; margin-bottom: 4px; }
    .map__row { display: flex; gap: 14px; align-items: flex-start; }
    .map__row svg { flex-shrink: 0; color: var(--primary); margin-top: 3px; }
    .map__row b { display: block; font-size: 0.92rem; }
    .map__row span { font-size: 0.9rem; color: var(--text-soft); }
    .map__btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }

    /* ============ CONTATTI ============ */
    .contacts__grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
    .contacts__card {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--radius-md); padding: 30px 28px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .contacts__card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
    .contacts__card h3 { font-size: 1.25rem; margin-bottom: 8px; display: flex; align-items: center; gap: 10px; }
    .contacts__card h3 svg { color: var(--primary); }
    /* Icone card contatti: pop in entrata */
    .contacts__card h3 svg { animation: iconPop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
    .contacts__card:nth-child(1) h3 svg { animation-delay: 0.35s; }
    .contacts__card:nth-child(2) h3 svg { animation-delay: 0.55s; }
    .contacts__card:nth-child(3) h3 svg { animation-delay: 0.75s; }
    @keyframes iconPop {
      from { transform: scale(0) rotate(-25deg); opacity: 0; }
      to { transform: scale(1) rotate(0deg); opacity: 1; }
    }
    .contacts__card p { font-size: 0.95rem; color: var(--text-soft); }
    .contacts__card a { color: var(--primary-dark); font-weight: 500; }
    .contacts__card a:hover { text-decoration: underline; }

    /* ============ FOOTER ============ */
    .footer { background: var(--bg-deep-2); color: rgba(243, 236, 221, 0.7); padding: 60px 0 30px; }
    .footer__top { display: flex; flex-wrap: wrap; gap: 30px; justify-content: space-between; align-items: flex-start; padding-bottom: 34px; border-bottom: 1px solid rgba(250, 245, 233, 0.1); }
    .footer__brand { font-family: var(--font-display); font-size: 1.7rem; color: #F3E7C8; }
    .footer__brand span { display: block; font-family: var(--font-body); font-size: 0.7rem; letter-spacing: 2.5px; text-transform: uppercase; color: var(--accent); margin-top: 4px; }
    .footer__links { display: flex; flex-wrap: wrap; gap: 22px; font-size: 0.92rem; }
    .footer__links a:hover { color: #E4C98F; }
    .footer__bottom { padding-top: 26px; font-size: 0.82rem; text-align: center; color: rgba(243, 236, 221, 0.45); }
    .footer__bottom a { color: rgba(243, 236, 221, 0.6); }

    /* ============ WHATSAPP FLOAT ============ */
    .wa-float {
      position: fixed; bottom: 22px; right: 22px; z-index: 90;
      width: 58px; height: 58px; border-radius: 50%;
      background: #25D366; color: #fff;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 10px 30px rgba(37, 211, 102, 0.45);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      opacity: 0; transform: scale(0.6);
    }
    .wa-float.visible { opacity: 1; transform: scale(1); animation: waWiggle 0.7s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .wa-float:hover { transform: scale(1.1); box-shadow: 0 14px 40px rgba(37, 211, 102, 0.55); }
    @keyframes waWiggle {
      0% { transform: scale(0.4) rotate(-12deg); }
      55% { transform: scale(1.12) rotate(8deg); }
      75% { transform: scale(0.96) rotate(-4deg); }
      100% { transform: scale(1) rotate(0deg); }
    }
    .wa-float::before {
      content: ""; position: absolute; inset: -6px; border-radius: 50%;
      border: 2px solid rgba(37, 211, 102, 0.4);
      animation: waPulse 2.4s ease-out infinite;
    }
    @keyframes waPulse { 0% { transform: scale(0.85); opacity: 1 } 100% { transform: scale(1.35); opacity: 0 } }

    /* ============ SCROLL REVEAL (anti-flash) ============ */
    .reveal { opacity: 0; transform: translateY(30px); }
    .reveal--delay-1 { transition-delay: 0.1s; }
    .reveal--delay-2 { transition-delay: 0.2s; }

    /* Safety net: se GSAP non carica entro 4s, tutto visibile */
    .safety-net .reveal, .safety-net .wrd, .safety-net .menu__item, .safety-net .gallery__item, .safety-net .el-in { opacity: 1 !important; transform: none !important; }

    /* Storia: stack foto */
    .storia__photos { position: relative; }

    /* ============ RESPONSIVE ============ */
    @media (min-width: 768px) {
      .gallery__grid { grid-template-columns: repeat(4, 1fr); }
      .menu__grid { grid-template-columns: 1fr 1fr; gap: 56px; }
      .storia__grid { grid-template-columns: 5fr 6fr; gap: 60px; }
      .rev__wrap { grid-template-columns: 4fr 6fr; gap: 60px; }
      .map__wrap { grid-template-columns: 7fr 5fr; }
      .contacts__grid { grid-template-columns: repeat(3, 1fr); }
      .section { padding: 120px 0; }
    }
    @media (min-width: 1024px) {
      .storia__photo--offset { margin-top: -40px; width: 80%; }
    }
  </style>

  <!-- noscript: senza JS tutto visibile -->
  <noscript>
    <style>
      .reveal, .wrd, .menu__item, .gallery__item, .el-in { opacity: 1 !important; transform: none !important; }
      .hero__badge, .hero__title .line span, .hero__sub, .hero__cta, .hero__stats { opacity: 1 !important; transform: none !important; animation: none !important; }
      .hero__light { transform: none !important; opacity: 1 !important; }
      .wa-float { opacity: 1; transform: scale(1); }
    </style>
  </noscript>

  <!-- Safety net: se GSAP non è vivo entro 4s, mostra tutto. Se GSAP è vivo, non tocca nulla. -->
  <script is:inline>
    setTimeout(function () {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        document.documentElement.classList.add('safety-net');
      }
    }, 4000);
  </script>
</head>
<body>
  <slot />
  <script is:inline src="/scripts/animations.js"></script>
</body>
</html>
