---
const lat = 41.6840989;
const lon = 12.7761052;
const waUrl = "https://wa.me/390685350920?text=Ciao%20Dino%2C%20vorrei%20prenotare%20un%20tavolo%20al%20Sotterraneo!";
---

<section class="section" id="mappa">
  <div class="container">
    <span class="section__label el-in">Come arrivare</span>
    <h2 class="section__title" style="margin-bottom:40px">Nel cuore di Velletri, <em>sotto la strada</em></h2>
    <div class="map__wrap reveal">
      <div class="map__frame" id="map" aria-label="Mappa: Corso della Repubblica 372, Velletri"></div>
      <div class="map__info">
        <div>
          <h3>Il Sotterraneo Osteria Urbana</h3>
          <span style="color:var(--text-soft);font-size:0.92rem">Corso della Repubblica, 372 · 00049 Velletri RM</span>
        </div>
        <div class="map__row">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21C7 17 3 13.5 3 9.5 3 6.5 5.5 4 8.5 4c1.4 0 2.6.6 3.5 1.6C12.9 4.6 14.1 4 15.5 4 18.5 4 21 6.5 21 9.5c0 4-4 7.5-9 11.5z" stroke-linejoin="round"/></svg>
          <div><b>Indirizzo</b><span>Corso della Repubblica, 372 — a due passi dal centro</span></div>
        </div>
        <div class="map__row">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5c0 8 7 15 15 15l2-4-5-2-2 2c-2.5-1.2-5.8-4.5-7-7l2-2-2-5z" stroke-linejoin="round"/></svg>
          <div><b>Telefono</b><span><a href="tel:+390685350920">06 8535 0920</a></span></div>
        </div>
        <div class="map__row">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2l7 3v6c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V5z" stroke-linejoin="round"/></svg>
          <div><b>Orari</b><span><a href="https://www.google.com/maps/search/Il+Sotterraneo+Osteria+Urbana+Velletri/" target="_blank" rel="noopener">Orari aggiornati su Google Maps</a></span></div>
        </div>
        <div class="map__btns">
          <a href="https://www.google.com/maps/dir/?api=1&destination=41.6840989,12.7761052" class="btn btn--primary" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21C7 17 3 13.5 3 9.5 3 6.5 5.5 4 8.5 4c1.4 0 2.6.6 3.5 1.6C12.9 4.6 14.1 4 15.5 4 18.5 4 21 6.5 21 9.5c0 4-4 7.5-9 11.5z" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            Portami lì
          </a>
          <a href={waUrl} class="btn btn--outline" target="_blank" rel="noopener">Prenota su WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function initMap() {
    if (typeof L === 'undefined') {
      if (!window.__mapRetries) window.__mapRetries = 0;
      if (++window.__mapRetries > 40) return;
      setTimeout(initMap, 250);
      return;
    }
    var mapEl = document.getElementById('map');
    if (!mapEl) return;
    var map = L.map('map').setView([41.6840989, 12.7761052], 16);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
      maxZoom: 19
    }).addTo(map);
    var pinIcon = L.divIcon({
      className: 'map-pin-wrap',
      html: '<div class="map-pin"><span class="map-pin__dot"></span><span class="map-pin__ring"></span></div>',
      iconSize: [34, 34], iconAnchor: [17, 17]
    });
    L.marker([41.6840989, 12.7761052], { icon: pinIcon }).addTo(map)
      .bindPopup('<b>Il Sotterraneo Osteria Urbana</b><br/>Corso della Repubblica, 372<br/>00049 Velletri RM')
      .openPopup();
    map.scrollWheelZoom.disable();
  })();
</script>
